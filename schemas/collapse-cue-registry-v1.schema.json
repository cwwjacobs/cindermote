{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CollapseCueRegistryV1",
  "description": "Registry of deterministic triggers and required collapse actions.",
  "type": "object",
  "required": ["version", "cues"],
  "properties": {
    "version": { "type": "string", "const": "v1" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cue_id", "trigger_condition", "terminal_action"],
        "properties": {
          "cue_id": { "type": "string" },
          "trigger_condition": { "type": "string" },
          "terminal_action": {
            "type": "string",
            "enum": ["ALLOW", "DENY", "QUARANTINE", "COLLAPSE"]
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
