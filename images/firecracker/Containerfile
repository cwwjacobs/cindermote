# The immutable digest prevents a later bookworm-slim tag move from changing
# the browser guest underneath the build receipt.
FROM docker.io/library/debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ENV DEBIAN_FRONTEND=noninteractive
ARG SOURCE_DATE_EPOCH=1784160000
ARG CHROMIUM_VERSION=150.0.7871.124-1~deb12u1
ARG DEBIAN_SNAPSHOT=20260716T110000Z
# The base-image digest fixes the initial filesystem; the dated Debian
# snapshots fix every package selected by apt. Release signatures remain the
# package authority even though the snapshot endpoint is HTTP in the minimal
# base (which intentionally has no CA bundle yet).
RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
      -e "s|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends \
       ca-certificates \
       chromium=${CHROMIUM_VERSION} \
       chromium-common=${CHROMIUM_VERSION} \
       chromium-sandbox=${CHROMIUM_VERSION} \
       fonts-liberation \
       iproute2 \
       libsodium23 \
       python3 \
       python3-cryptography \
    && rm -rf \
       /var/lib/apt/lists/* \
       /var/cache/apt/* \
       /var/cache/ldconfig/aux-cache \
       /var/log/apt/* \
       /var/log/alternatives.log \
       /var/log/dpkg.log \
    && rm -f /var/lib/dbus/machine-id \
    && : > /etc/machine-id \
    && useradd --uid 1000 --user-group --home-dir /home/probe --shell /usr/sbin/nologin probe \
    && install -d -o probe -g probe -m 0700 /home/probe \
    && install -d -m 0755 /job /run/cindermote /opt/cindermote /dev/shm
RUN test "$(dpkg-query -W chromium chromium-common chromium-sandbox | cut -f2 | sort -u)" = "${CHROMIUM_VERSION}"

COPY guest/browser_agent.py /opt/cindermote/browser_agent.py
COPY guest/agent_probe_agent.py /opt/cindermote/agent_probe_agent.py
COPY mote/browser_contract.py /opt/cindermote/browser_contract.py
COPY agent_probe/__init__.py /opt/cindermote/agent_probe/__init__.py
COPY agent_probe/canonical.py /opt/cindermote/agent_probe/canonical.py
COPY agent_probe/evidence.py /opt/cindermote/agent_probe/evidence.py
COPY agent_probe/hpke.py /opt/cindermote/agent_probe/hpke.py
COPY agent_probe/protocol.py /opt/cindermote/agent_probe/protocol.py
COPY agent_probe/secretstream.py /opt/cindermote/agent_probe/secretstream.py
COPY guest/cindermote-init /sbin/cindermote-init
RUN chmod 0444 /opt/cindermote/browser_contract.py \
        /opt/cindermote/agent_probe/__init__.py \
        /opt/cindermote/agent_probe/canonical.py \
        /opt/cindermote/agent_probe/evidence.py \
        /opt/cindermote/agent_probe/hpke.py \
        /opt/cindermote/agent_probe/protocol.py \
        /opt/cindermote/agent_probe/secretstream.py \
    && chmod 0555 /opt/cindermote/browser_agent.py /opt/cindermote/agent_probe_agent.py /sbin/cindermote-init \
    && python3 -I -B -c 'import cryptography; import ctypes.util; assert ctypes.util.find_library("sodium")' \
    && test -u /usr/lib/chromium/chrome-sandbox \
    && chromium --version > /opt/cindermote/chromium.version \
    && sha256sum /usr/lib/chromium/chromium > /opt/cindermote/chromium.sha256

ENTRYPOINT ["/sbin/cindermote-init"]
